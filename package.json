{
  "name": "league-of-ordinary-gentlemen",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/operations/assert-production-boundary.mjs && node --test tests/production-release-rules.test.mjs tests/global-routing-completeness.test.mjs && node scripts/restore-approved-reels.mjs && node scripts/assets/prepare-images.mjs && next build",
    "start": "next start",
    "test": "node --test tests/*.test.mjs",
    "assets:images": "node scripts/assets/prepare-images.mjs",
    "qa:browser": "playwright test",
    "media:preflight": "node scripts/operations/prepare-media.mjs preflight",
    "media:prepare": "node scripts/operations/prepare-media.mjs prepare",
    "media:assemble": "node scripts/operations/assemble-prepared-media.mjs",
    "media:transport": "node scripts/operations/transport-prepared-media.mjs",
    "media:completion": "node scripts/operations/native-media-completion-turn.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.117.2",
    "next": "latest",
    "react": "latest",
    "react-dom": "latest",
    "sharp": "latest"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1"
  }
}
